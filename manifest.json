{
	"_version": "1.76.0",
	"sap.app": {
		"id": "apps.dflc.threecluesgame",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"",
				"en",
				"pt-BR"
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:basic",
			"version": "1.19.1",
			"toolsId": "bdca2c9e-97c3-416c-9440-d7157157b30c"
		},
		"crossNavigation": {
			"inbounds": {
				"ThreeCluesGame-show": {
					"semanticObject": "ThreeCluesGame",
					"action": "show",
					"title": "{{ThreeCluesGame-show.flpTitle}}",
					"subTitle": "{{ThreeCluesGame-show.flpSubtitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.150.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "apps.dflc.threecluesgame.i18n.i18n",
					"supportedLocales": [
						"",
						"en",
						"pt-BR"
					]
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/variables.css"
				},
				{
					"uri": "css/layout.css"
				},
				{
					"uri": "css/animations.css"
				},
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"controlAggregation": "pages",
				"controlId": "app",
				"transition": "slide",
				"type": "View",
				"viewType": "XML",
				"path": "apps.dflc.threecluesgame.view",
				"async": true,
				"viewPath": "apps.dflc.threecluesgame.view"
			},
			"routes": [
				{
					"name": "Start",
					"pattern": "",
					"target": "Start"
				},
				{
					"name": "Game",
					"pattern": "game",
					"target": "Game"
				},
				{
					"name": "Result",
					"pattern": "result",
					"target": "Result"
				}
			],
			"targets": {
				"Start": {
					"id": "Start",
					"name": "Start"
				},
				"Game": {
					"id": "Game",
					"name": "Game"
				},
				"Result": {
					"id": "Result",
					"name": "Result"
				}
			}
		},
		"rootView": {
			"viewName": "apps.dflc.threecluesgame.view.App",
			"type": "XML",
			"id": "App",
			"async": true
		},
		"flexBundle": false
	},
	"sap.cloud": {
		"public": true,
		"service": "appsdflcthreecluesgame"
	}
}