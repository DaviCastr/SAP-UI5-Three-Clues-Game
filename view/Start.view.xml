<mvc:View
    controllerName="apps.dflc.threecluesgame.controller.Start"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Page showHeader="false" class="tcgPage">
        <content>
            <VBox
                width="100%"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
                class="tcgStartContainer">

                <!-- 🎭 TÍTULO DO JOGO -->
                <VBox alignItems="Center" class="tcgHeaderBox sapUiMediumMarginBottom">
                    <Title
                        text="{i18n>start.title}"
                        level="H3"
                        class="tcgMainTitle"/>
                    <Button
                        icon="sap-icon://hint"
                        text="{i18n>start.howToPlay}"
                        type="Emphasized"
                        press=".onShowHowToPlay"
                        tooltip="{i18n>start.howToPlay}"
                        class="sapUiTinyMarginBegin"/>
                </VBox>

                <!-- 🎛️ CARD DE CONFIGURAÇÕES -->
                <VBox class="tcgStartCard">

                    <!-- JOGADOR 1 -->
                    <Label text="{i18n>start.player1Label}" class="tcgInputLabel"/>
                    <Input
                        value="{game>/players/player1/name}"
                        placeholder="{i18n>start.player1Placeholder}"
                        class="tcgInput sapUiTinyMarginBottom"/>

                    <!-- JOGADOR 2 -->
                    <Label text="{i18n>start.player2Label}" class="tcgInputLabel sapUiTinyMarginTop"/>
                    <Input
                        value="{game>/players/player2/name}"
                        placeholder="{i18n>start.player2Placeholder}"
                        class="tcgInput sapUiTinyMarginBottom"/>

                    <!-- TEMPO DA RODADA -->
                    <Label text="{i18n>start.roundTimeLabel}" class="tcgInputLabel sapUiTinyMarginTop"/>
                    <Select
                        selectedKey="{game>/settings/roundTime}"
                        width="100%"
                        class="tcgSelect sapUiTinyMarginBottom"
                        visible="true">
                        <core:Item key="0" text="∞" />
                        <core:Item key="5" text="5 s" />
                        <core:Item key="10" text="10 s"/>
                        <core:Item key="20" text="20 s"/>
                        <core:Item key="30" text="30 s"/>
                        <core:Item key="40" text="40 s"/>
                        <core:Item key="50" text="50 s"/>
                        <core:Item key="60" text="60 s"/>
                    </Select>

                    <!-- Se preferir manter o texto simples nos itens do Select sem o formatter complexo:
                         substitua os core:Item por texto direto traduzido ou formate assim: -->
                    <!-- 
                    <Select
                        selectedKey="{game>/settings/roundTime}"
                        width="100%"
                        class="tcgSelect sapUiTinyMarginBottom"
                        visible="true">
                        <core:Item key="5" text="5s"/>
                        <core:Item key="10" text="10s"/>
                        <core:Item key="20" text="20s"/>
                        <core:Item key="30" text="30s"/>
                        <core:Item key="40" text="40s"/>
                    </Select> 
                    -->

                    <!-- OPÇÕES (CHECKBOXES) -->
                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop sapUiTinyMarginBottom" visible="true">
                        <CheckBox
                            text="{i18n>start.sounds}"
                            selected="{game>/settings/sounds}"
                            class="tcgCheckBox"/>
                        <CheckBox
                            text="{i18n>start.showCategory}"
                            selected="{game>/settings/showCategory}"
                            class="tcgCheckBox"/>
                    </HBox>

                    <!-- UPLOAD DE PERGUNTAS CUSTOMIZADAS (FILE UPLOADER) -->
                    <VBox class="tcgFileSection sapUiTinyMarginTop">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <Label text="{i18n>start.envelopesLabel}" class="tcgInputLabel"/>
                            <Button
                                text="{i18n>start.downloadTemplate}"
                                type="Transparent"
                                press=".onDownloadTemplate"
                                class="tcgDownloadBtn"/>
                        </HBox>

                        <u:FileUploader
                            id="fileUploader"
                            fileType="json"
                            placeholder="{i18n>start.filePlaceholder}"
                            buttonText="{i18n>start.browseBtn}"
                            width="100%"
                            change=".onFileSelected"
                            class="tcgFileUploader sapUiTinyMarginTop"/>
                    </VBox>

                    <!-- BOTÃO INICIAR -->
                    <Button
                        text="{i18n>start.startGame}"
                        type="Emphasized"
                        press=".onStartGame"
                        width="100%"
                        class="tcgMainBtn sapUiMediumMarginTop"/>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>