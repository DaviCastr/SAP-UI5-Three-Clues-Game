<mvc:View
    controllerName="apps.dflc.threecluesgame.controller.Start"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Page showHeader="false" class="tcgPage">
        <content>
            <VBox
                width="100%"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
                class="tcgStartContainer">

                <!-- 🎭 TÍTULO DO JOGO -->
                <VBox alignItems="Center" class="tcgHeaderBox sapUiMediumMarginBottom">
                    <Title
                        text="THREE CLUES GAME"
                        level="H1"
                        class="tcgMainTitle"/>

                    <Text
                        text="JOGO DAS 3 PISTAS"
                        class="tcgSubTitle"/>
                </VBox>

                <!-- 🎛️ CARD DE CONFIGURAÇÕES -->
                <VBox class="tcgStartCard">

                    <!-- JOGADOR 1 -->
                    <Label text="👤 Jogador 1" class="tcgInputLabel"/>
                    <Input
                        value="{game>/players/player1/name}"
                        placeholder="Nome do Jogador 1"
                        class="tcgInput sapUiTinyMarginBottom"/>

                    <!-- JOGADOR 2 -->
                    <Label text="👤 Jogador 2" class="tcgInputLabel sapUiTinyMarginTop"/>
                    <Input
                        value="{game>/players/player2/name}"
                        placeholder="Nome do Jogador 2"
                        class="tcgInput sapUiTinyMarginBottom"/>

                    <!-- TEMPO DA RODADA -->
                    <Label text="⏱️ Tempo da rodada" class="tcgInputLabel sapUiTinyMarginTop"/>
                    <Select
                        selectedKey="{game>/settings/roundTime}"
                        width="100%"
                        class="tcgSelect sapUiTinyMarginBottom"
                        visible="true">
                        <core:Item key="5" text="5 segundos"/>
                        <core:Item key="10" text="10 segundos"/>
                        <core:Item key="20" text="20 segundos"/>
                        <core:Item key="30" text="30 segundos"/>
                        <core:Item key="40" text="40 segundos"/>
                    </Select>

                    <!-- OPÇÕES (CHECKBOXES) -->
                    <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginTop sapUiTinyMarginBottom"  visible="true">
                        <CheckBox
                            text="🔊 Sons"
                            selected="{game>/settings/sounds}"
                            class="tcgCheckBox"/>
                        <CheckBox
                            text="🏷 Mostrar categoria"
                            selected="{game>/settings/showCategory}"
                            class="tcgCheckBox"/>
                    </HBox>

                    <!-- UPLOAD DE PERGUNTAS CUSTOMIZADAS (FILE UPLOADER) -->
                    <VBox class="tcgFileSection sapUiTinyMarginTop">
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <Label text="📂 Envelopes (Opcional)" class="tcgInputLabel"/>
                            <Button
                                text="📥 Baixar Modelo"
                                type="Transparent"
                                press=".onDownloadTemplate"
                                class="tcgDownloadBtn"/>
                        </HBox>

                        <u:FileUploader
                            id="fileUploader"
                            fileType="json"
                            placeholder="Selecione um arquivo .json"
                            buttonText="Buscar"
                            width="100%"
                            change=".onFileSelected"
                            class="tcgFileUploader sapUiTinyMarginTop"/>
                    </VBox>

                    <!-- BOTÃO INICIAR -->
                    <Button
                        text="🚀 INICIAR JOGO"
                        type="Emphasized"
                        press=".onStartGame"
                        width="100%"
                        class="tcgMainBtn sapUiMediumMarginTop"/>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>